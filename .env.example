# Copy to .env and adjust. Consumed by docker-compose, game-api and card-forge.

# --- Postgres (docker-compose) ---
POSTGRES_USER=cardgame
POSTGRES_PASSWORD=cardgame
POSTGRES_DB=cardgame
POSTGRES_PORT=5433

# --- game-api ---
API_PORT=3000
# Bind address. 127.0.0.1 keeps the admin API off the local network.
API_HOST=127.0.0.1
DATABASE_URL=postgres://cardgame:cardgame@localhost:5433/cardgame
# Root of the shared art folder, relative to repo root or absolute.
STORAGE_DIR=../storage
# Prefix the API prepends to image_path/thumb_path when building DTOs.
STATIC_BASE_URL=http://localhost:3000/static
# Exposes genMeta on GET /cards/:id. Keep off outside local dev.
EXPOSE_GEN_META=true
# Comma-separated allowlist of browser origins. No wildcard: this is a token API.
CORS_ORIGINS=http://localhost:5173
# Signing key for player access tokens. No default — the API refuses to start
# without it, because a default secret is the same as having no auth at all.
JWT_SECRET=
# Static bearer token for the card-forge batch ingest (machine client, no JWT).
# Unset means POST /api/admin/cards/ingest rejects every request.
FORGE_SERVICE_TOKEN=

# --- seeding ---
# Set to 1 to allow `npm run seed -- --reset` to TRUNCATE. Leave unset otherwise.
ALLOW_DESTRUCTIVE_SEED=
# Credentials for the player row created by `npm run seed`. Without both, the
# seeder creates no player and points you at `npm run account:bind` instead.
SEED_PLAYER_EMAIL=
SEED_PLAYER_PASSWORD=

# --- game-ui ---
VITE_API_BASE_URL=http://localhost:3000/api
# 1 = run against MSW mocks instead of a live game-api
VITE_USE_MOCKS=0

# --- card-forge ---
FORGE_API_URL=http://localhost:3000/api
FORGE_STORAGE_DIR=../storage
FORGE_MODEL_ID=Lykon/dreamshaper-8
# Keep the ~2GB model cache off the system drive if you like.
HF_HOME=
