{
  "name": "mini-game-sb",
  "version": "0.1.0",
  "private": true,
  "description": "Local fantasy card game with cases and a horizontal roulette. Art generated locally with Stable Diffusion 1.5.",
  "workspaces": [
    "packages/*",
    "game-api",
    "game-ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "brain:impact": "node scripts/check-agent-context.mjs --impact",
    "brain:product": "node scripts/brain-product.mjs",
    "brain:retrieve": "node scripts/brain-retrieve.mjs",
    "check:brain": "node scripts/check-agent-context.mjs && node --test scripts/brain-retrieve.test.mjs scripts/brain-product.test.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build:types": "npm run build --workspace @card-game/shared-types",
    "dev:api": "npm run start:dev --workspace game-api",
    "dev:ui": "npm run dev --workspace game-ui",
    "sync:brain": "node scripts/check-agent-context.mjs --write-generated",
    "test": "npm run check:brain && npm run test --workspaces --if-present"
  }
}
